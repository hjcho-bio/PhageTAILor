# Command implementations
# ───────────────────────────────────────────────────────────────────────────

def cmd_run(args):
    inp = Path(args.input).expanduser().resolve()
    out = Path(args.out).expanduser().resolve()
    out.mkdir(parents=True, exist_ok=True)
    print(f"\nPhageTAILor v0.1.0 — running on input: {inp}", flush=True)
    triples = discover_genomes(inp)
    print(f"  resolved {len(triples)} genome(s)", flush=True)

    # Stage one symlink per sample, named {sample_name}.fna. This guarantees
    # the sample_name supplied by the user is the name Snakemake derives
    # from the FASTA basename, so all downstream tables key on user names.
    stage = out / "_input_fnas"
    stage.mkdir(parents=True, exist_ok=True)
    paths_file = out / "_input_genomes.txt"
    samples_file = out / "_samples.tsv"
    with open(paths_file, "w") as pf, open(samples_file, "w") as sf:
        sf.write("sample_number\tsample_name\tsample_fasta_directory\n")
        for snum, name, fna in triples:
            link = stage / f"{name}.fna"
            if link.exists() or link.is_symlink():
                link.unlink()
            link.symlink_to(fna)
            pf.write(f"{link}\n")
            sf.write(f"{snum}\t{name}\t{fna}\n")

    sm = shutil.which("snakemake")
    if sm is None:
        die("`snakemake` not found on PATH. Install it (e.g. `conda install -c bioconda snakemake`) and retry. You can also pass --skip-snakemake to dry-run.")
    cfg = THIS_DIR / "config" / "config.yaml"
    if not cfg.exists(): die(f"Bundled config not found at {cfg}. Did you clone the repo correctly?")

    cmd = [sm,
           "-s", str(WORKFLOW),
           "--cores", str(args.cores),
           "--configfile", str(cfg),
           "--config", f"genome_list={paths_file}", f"output_dir={out}", f"modules={args.modules}",
           "--rerun-incomplete",
           "-p"]
    if args.use_conda: cmd.append("--use-conda")

    all_steps = ["annotation","taxonomy","phage","tailocin","t6ss","ecis","hmm_tail","features","classify","report"]
    if args.modules == "all":
        print("\nThe pipeline will run the following steps in order:\n")
        for s in all_steps:
            print(f"  • {s}")
    else:
        print(f"\nRunning selected modules: {args.modules}")
        print("  (any prerequisite stages are added automatically)")
    print("\nRun `phagetailor explain <step>` to learn what any step does.\n", flush=True)
    if args.dry_run:
        cmd.append("-n")
        print("(dry-run mode — not actually running, just listing what would run)\n", flush=True)
    print(f"  command: {' '.join(cmd)}\n", flush=True)
    r = subprocess.run(cmd)
    if r.returncode != 0:
        die(f"snakemake exited with non-zero status {r.returncode}. See the log lines above. For help, run `phagetailor explain <step>` for the failing step.")
    print(f"\n  DONE. Results in: {out}", flush=True)
    mods = args.modules
    runs_classifier = mods == "all" or any(m in mods.split(",") for m in ("report", "classify"))
    if runs_classifier:
        print(f"  - Open '{out}/report/summary.html' in a browser for a summary.", flush=True)
        print(f"  - Or open '{out}/report/per_genome_predictions.tsv' in Excel for a per-genome table.\n", flush=True)
    else:
        print(f"  - Detector-only run ({mods}); see the per-detector candidate tables under '{out}/'", flush=True)
        print(f"    (e.g. '{out}/phage/prophages.tsv' for geNomad prophages).\n", flush=True)

def cmd_check(args):
    print("\nChecking that PhageTAILor's required tools and databases are installed:\n")
    n_missing = 0
    # Only snakemake must be on PATH. Every other tool (geNomad, GTDB-Tk, MMseqs2,
    # HMMER, skani, Pyrodigal-gv) lives in a per-rule conda env that Snakemake
    # creates automatically under --use-conda. Probing PATH for them is wrong:
    # they are intentionally NOT in the launcher environment.
    sm = shutil.which("snakemake")
    if sm:
        print(f"  [OK]    {'snakemake':<20} {sm}")
    else:
        print(f"  [MISS]  {'snakemake':<20} conda create -n phagetailor -c conda-forge -c bioconda snakemake")
        n_missing += 1
    print()
    print("  Pipeline tools (geNomad, GTDB-Tk, MMseqs2, HMMER, skani, Pyrodigal-gv)")
    print("  are provided by per-rule conda environments that Snakemake builds on")
    print("  first run. You do not create or activate them yourself.\n")
    for db, name, hint in [
        ("resources/secret6_db/secret6_exp_db", "SecReT6 DB", ""),
        ("resources/ecistem_db/ecistem_db", "eCIStem DB", ""),
        ("resources/phrogs_db/phrogs_mmseqs_db/phrogs_profile_db_seq", "PHROGS DB",
         "run: bash scripts/setup_databases.sh"),
        ("resources/tailgenes_db/tailgenes_db", "tail-gene DB", ""),
        ("resources/hmm_tail_db/hmm_tail_full.hmm", "tail-HMM library",
         "run: bash scripts/setup_databases.sh"),
        ("resources/hmm_tail_db/hmm_tail_detector.hmm", "tail-HMM detector subset",
         "run: bash scripts/setup_databases.sh"),
        ("resources/training_sketch/sketch_db", "training sketch",
         "run: bash scripts/setup_databases.sh"),
        ("resources/model/multiclass.txt", "LightGBM multiclass model", ""),
    ]:
        p = THIS_DIR / db
        if p.exists():
            print(f"  [OK]    {name:<26} {p}")
        else:
            extra = f"  ({hint})" if hint else ""
            print(f"  [MISS]  {name:<26} expected at {p}{extra}")
            n_missing += 1
    print()
    if n_missing == 0:
        print("  All required components found. You are ready to run `phagetailor run`.\n")
    else:
        print(f"  {n_missing} missing component(s). See README for install instructions.\n")
        sys.exit(1)

def cmd_explain(args):
    step = args.step.lower()
    if step in ("all","list"):
        print("\nAvailable steps (in pipeline order):\n")
        for s in ["annotation","taxonomy","phage","tailocin","t6ss","ecis","hmm_tail","features","classify","report","input"]:
            print(f"  phagetailor explain {s}")
        print()
        return
    if step not in STEP_EXPLAIN:
        die(f"Unknown step: {step}. Run `phagetailor explain list` to see options.")
    print(textwrap.dedent(STEP_EXPLAIN[step]))

