#!/usr/bin/env python3
"""PhageTAILor v0.1.0 — beginner-friendly command-line interface.

Usage:
    phagetailor run    <samples.tsv>  [--out DIR] [--cores N]
    phagetailor check
    phagetailor explain <step>
    phagetailor example

Input is a tab-separated `.tsv` file (or `.txt`, if tab-separated) with
three columns:
    sample_number    sample_name    sample_fasta_directory

Run `phagetailor --help` for the full guide; or `phagetailor explain <step>`
to learn what each part of the pipeline does in plain language.
"""
from __future__ import annotations
import argparse, os, shutil, subprocess, sys, textwrap
from pathlib import Path

THIS_DIR = Path(__file__).resolve().parent
WORKFLOW = THIS_DIR / "workflow" / "Snakefile"
DEFAULT_OUT = Path.cwd() / "phagetailor_results"

