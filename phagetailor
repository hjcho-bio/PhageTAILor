def main():
    parser = argparse.ArgumentParser(
        prog="phagetailor",
        description=textwrap.dedent("""\
        PhageTAILor v0.1.0 — find phage tail-like elements (tailocins,
        prophages, T6SS, eCIS) in bacterial genomes.

        Beginner-friendly usage:
            phagetailor run samples.tsv  --out my_results/  --cores 8

        Input is a tab-separated values file (`.tsv` preferred, `.txt`
        also accepted) with three columns:
            sample_number   sample_name   sample_fasta_directory

        See `phagetailor example` for a guided quick start, or
        `phagetailor explain input` for the input-file format, or
        `phagetailor explain <step>` to learn what each pipeline step does.
        """),
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=textwrap.dedent("""\
        Common commands:
            phagetailor run <input>     run the pipeline on your genomes
            phagetailor check           verify everything is installed
            phagetailor explain <step>  explain a pipeline step in plain language
            phagetailor example         show a guided quick-start example

        Pipeline steps (run `phagetailor explain <step>` for details):
            annotation taxonomy phage tailocin t6ss ecis hmm_tail features classify report
        """)
    )
    sub = parser.add_subparsers(dest="cmd")

    p_run = sub.add_parser("run", help="run the pipeline on your genomes",
        description="Run PhageTAILor on a tab-separated samples file (.tsv or .txt). No YAML editing required. Run `phagetailor explain input` for the format.")
    p_run.add_argument("input", help="tab-separated .tsv (or .txt) with columns: sample_number, sample_name, sample_fasta_directory (see `phagetailor explain input`)")
    p_run.add_argument("--out", default=str(DEFAULT_OUT), help="output directory (default: ./phagetailor_results)")
    p_run.add_argument("--cores", type=int, default=8, help="CPU cores to use (default: 8)")
    p_run.add_argument("--modules", default="all",
        help="comma-separated subset of pipeline stages to run (default: all). "
             "Prerequisites are added automatically, e.g. `--modules phage` runs a "
             "prophage-only scan. Stages: annotation, taxonomy, phage, tailocin, t6ss, ecis, "
             "hmm_tail, features, classify, report.")
    p_run.add_argument("--use-conda", dest="use_conda", action="store_true", default=True,
                       help="let Snakemake build the per-rule conda envs (default: ON). "
                            "You do not need to create or activate these yourself.")
    p_run.add_argument("--no-use-conda", dest="use_conda", action="store_false",
                       help="do not use conda envs; requires every tool already on PATH")
    p_run.add_argument("--dry-run", action="store_true", help="show what would run without running it")
    p_run.set_defaults(func=cmd_run)

    p_check = sub.add_parser("check", help="verify all required tools and databases are installed")
    p_check.set_defaults(func=cmd_check)

    p_explain = sub.add_parser("explain", help="explain a pipeline step in plain language",
        description="Get a beginner-friendly explanation of one step.")
    p_explain.add_argument("step", help=f"one of: {', '.join(STEP_EXPLAIN.keys())}, list")
    p_explain.set_defaults(func=cmd_explain)

    p_example = sub.add_parser("example", help="show a guided quick-start example")
    p_example.set_defaults(func=cmd_example)

    args = parser.parse_args()
    if not getattr(args, "cmd", None):
        parser.print_help(); sys.exit(0)
    args.func(args)

if __name__ == "__main__":
    main()
