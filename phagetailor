# ───────────────────────────────────────────────────────────────────────────
# Helpers
# ───────────────────────────────────────────────────────────────────────────

def die(msg: str):
    print(f"\n  ERROR: {msg}\n", file=sys.stderr)
    print(f"  Run `phagetailor --help` or `phagetailor explain <step>` for help.\n", file=sys.stderr)
    sys.exit(1)

def warn(msg: str):
    print(f"  WARNING: {msg}", file=sys.stderr)

SAMPLE_NAME_RE = __import__("re").compile(r"^[A-Za-z0-9_.\-]+$")

def _resolve_fasta(path: Path, line_num: int) -> Path | None:
    """sample_fasta_directory can be a file or a directory. Return the FASTA path or None."""
    if path.is_file():
        return path
    if path.is_dir():
        fastas = sorted(list(path.glob("*.fna")) + list(path.glob("*.fasta")) + list(path.glob("*.fa")))
        if not fastas:
            warn(f"Line {line_num}: directory {path} contains no .fna/.fasta/.fa — skipping")
            return None
        if len(fastas) > 1:
            warn(f"Line {line_num}: {path} contains {len(fastas)} FASTAs; using the first ({fastas[0].name})")
        return fastas[0]
    warn(f"Line {line_num}: path does not exist: {path} — skipping")
    return None

def discover_genomes(inp: Path):
    """Parse the unified tab-separated input file.

    Returns a list of (sample_number, sample_name, fna_path) tuples.

    Required columns (case-insensitive, tab-separated header on first line):
        sample_number    sample_name    sample_fasta_directory
    """
    if not inp.exists():
        die(f"Input file does not exist: {inp}")
    if inp.is_dir():
        die(f"Input must be a tab-separated .txt file, not a directory: {inp}\n  Run `phagetailor explain input` for the required format.")

    with open(inp) as fh:
        header_line = fh.readline().rstrip("\n")
        if not header_line:
            die(f"Input file {inp} is empty. Run `phagetailor explain input`.")
        if "\t" not in header_line:
            die(f"Input must be TAB-separated. The header line of {inp} has no tabs.\n  Run `phagetailor explain input` for the required format.")
        header = [c.strip().lower() for c in header_line.split("\t")]
        required = ["sample_number", "sample_name", "sample_fasta_directory"]
        missing = [c for c in required if c not in header]
        if missing:
            die(f"Input header is missing required column(s): {', '.join(missing)}.\n  Found columns: {', '.join(header)}\n  Run `phagetailor explain input` for the required format.")
        i_num  = header.index("sample_number")
        i_name = header.index("sample_name")
        i_fa   = header.index("sample_fasta_directory")

        triples = []
        seen_names = set()
        for line_num, raw in enumerate(fh, start=2):
            line = raw.rstrip("\n")
            if not line.strip() or line.lstrip().startswith("#"):
                continue
            cols = line.split("\t")
            if len(cols) <= max(i_num, i_name, i_fa):
                warn(f"Line {line_num}: fewer columns than the header — skipping")
                continue
            snum = cols[i_num].strip()
            name = cols[i_name].strip()
            fa_str = cols[i_fa].strip()
            if not (snum and name and fa_str):
                warn(f"Line {line_num}: empty sample_number / sample_name / sample_fasta_directory — skipping")
                continue
            if not SAMPLE_NAME_RE.match(name):
                die(f"Line {line_num}: sample_name '{name}' contains illegal characters. Use letters, digits, '_', '.', '-' only (no spaces or path separators).")
            if name in seen_names:
                die(f"Line {line_num}: duplicate sample_name '{name}'. Each sample_name must be unique.")
            seen_names.add(name)
            fa = _resolve_fasta(Path(fa_str).expanduser(), line_num)
            if fa is None:
                continue
            triples.append((snum, name, str(fa.resolve())))

    if not triples:
        die(f"No genomes resolved from {inp}. Run `phagetailor explain input` for the required format.")
    return triples

